#!/usr/bin/env bash
# Chess Trainer entry point. Nothing here ever uses sudo.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"
VENV="$HERE/.venv"
PY="$VENV/bin/python"

ensure_venv() {
    if [ ! -x "$PY" ]; then
        echo "Creating a project-local venv in .venv (no root needed)..."
        python3 -m venv "$VENV"
    fi
    if ! "$PY" -c "import chess" >/dev/null 2>&1; then
        echo "Installing python-chess into .venv..."
        if ! "$VENV/bin/pip" install --quiet chess; then
            cat >&2 <<'MSG'
Could not install python-chess into .venv.

python-chess is pure Python and installs without root. If this failed because
there is no network, fetch the wheel elsewhere and install it with:

    .venv/bin/pip install /path/to/chess-*.whl

Nothing is installed with sudo; this script will not ask for root.
MSG
            exit 1
        fi
    fi
}

usage() {
    cat <<'MSG'
./run <command>

  web                     Start the server on 127.0.0.1:8770
  import <pgn-or-url>     Import a game or a PGN archive into the corpus
  import --player <name> [--time-class rapid] [--since YYYY-MM]
                          Import a chess.com player's whole history for one
                          time control. rapid by default; also blitz, bullet,
                          daily, a comma-separated list, or all. Re-running
                          picks up only what is new.
  phases --build          Rebuild the middlegame and endgame pools
  phases                  List the current pools with their evals
  tree                    Print recorded answers, per position and depth
  leaks                   Print the current leak list
  review [--depth 16] [--limit N]
                          Engine-review your games for the statistics.
                          Resumable; run it again after each import.
  warm                    Pre-analyse everything not yet cached
  doctor                  Check engine, DB, venv, port
  whoami <username>       Record which chess.com name is you
  test                    Run the test suite

Read-only commands take flags and never prompt. warm and phases --build
confirm before starting; --yes skips the gate.
MSG
}

cmd="${1:-}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
    ""|-h|--help|help) usage ;;
    web|import|phases|tree|leaks|warm|review|doctor|whoami)
        ensure_venv
        exec "$PY" -m server.cli "$cmd" "$@"
        ;;
    test)
        ensure_venv
        exec "$PY" -m unittest discover -s tests -v "$@"
        ;;
    *)
        echo "Unknown command: $cmd" >&2
        usage >&2
        exit 2
        ;;
esac
