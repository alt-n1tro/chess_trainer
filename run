#!/usr/bin/env bash
# Chess Trainer entry point. Nothing here ever uses sudo.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"
VENV="$HERE/.venv"
PY="$VENV/bin/python"

ensure_venv() {
    if [ ! -x "$PY" ]; then
        echo "Creating a project-local venv in .venv (no root needed)..."
        python3 -m venv "$VENV"
    fi
    if ! "$PY" -c "import chess" >/dev/null 2>&1; then
        echo "Installing python-chess into .venv..."
        if ! "$VENV/bin/pip" install --quiet chess; then
            cat >&2 <<'MSG'
Could not install python-chess into .venv.

python-chess is pure Python and installs without root. If this failed because
there is no network, fetch the wheel elsewhere and install it with:

    .venv/bin/pip install /path/to/chess-*.whl

Nothing is installed with sudo; this script will not ask for root.
MSG
            exit 1
        fi
    fi
}

usage() {
    ensure_venv
    "$PY" -m server.cli --help
    echo
    echo "  test                    Run the test suite"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
    ""|-h|--help|help) usage ;;
    web|import|review|phases|warm|whoami|doctor)
        ensure_venv
        exec "$PY" -m server.cli "$cmd" "$@"
        ;;
    test)
        ensure_venv
        exec "$PY" -m unittest discover -s tests -v "$@"
        ;;
    *)
        echo "Unknown command: $cmd" >&2
        echo "Try ./run help" >&2
        exit 2
        ;;
esac
